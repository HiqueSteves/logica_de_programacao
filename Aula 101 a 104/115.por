programa {
  funcao inicio() {
    inteiro numeros[4]

    numeros[0] = 10
    numeros[1] = 6
    numeros[2] = 5
    numeros[3] = 8

    escreva("Soma das posições 0 e 3: ", numeros[0] + numeros[3], "\n")
    escreva("Multiplicação das posições 1 e 2: ", numeros[1] + numeros[2], "\n")
    escreva("Diferença entre o valor da posição 2 e o valor da posição 0: ", numeros[2] - numeros[0], "\n")
  }
}

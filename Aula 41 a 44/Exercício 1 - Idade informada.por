programa {
  funcao inicio() {
    inteiro idade
    escreva("Digite sua idade: ")
    leia(idade)

    escreva("Idade informada: ", idade)
  }
}

//adicionei um "escreva" pro usuário poder digitar a sua idade, e mudei o "0" pela variavel "idade", porque sempre iria aparecer 0 ao invez da idade da pessoa.

programa
{
    funcao inicio()
    {
        inteiro largura, altura
        real area

        escreva("Digite a largura: ")
        leia(largura)
        escreva("Digite a altura: ")
        leia(altura)

        area = largura * altura

        escreva("Área: ", area)
    }
}
//adicionei um escreva para largura e altura